NEXT_PUBLIC_CURRENT_SITE_URL=https://www.adittya.site
GOOGLE_ANALYTICS_ID=your-google-analytics-id

# Upstash Redis (compteurs vues / j'aime)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sanity (contenu du site, géré sur /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret partagé avec le webhook Sanity -> /api/revalidate (mise à jour instantanée)
SANITY_REVALIDATE_SECRET=
# Uniquement pour l'import initial (npm run sanity:seed) — jeton "Editor", à ne pas mettre sur Vercel
SANITY_WRITE_TOKEN=
